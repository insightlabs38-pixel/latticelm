[Unit]
Description=LatticeLM bounded final-recipe research master (never launches final long run)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=insightlabs38
WorkingDirectory=/home/insightlabs38/latticelm
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/insightlabs38/latticelm/src
Environment=HF_HUB_ENABLE_HF_TRANSFER=0
ExecStart=/home/insightlabs38/latticelm/.venv/bin/python scripts/run_final_recipe_research_master.py
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2 75
TimeoutStopSec=1200
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
