[Unit]
Description=LatticeLM autonomous final-scale base pretraining master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=insightlabs38
WorkingDirectory=/home/insightlabs38/latticelm
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/insightlabs38/latticelm/src
ExecStart=/home/insightlabs38/latticelm/.venv/bin/python scripts/run_final_scale_master.py
ExecStop=/home/insightlabs38/latticelm/.venv/bin/python scripts/run_final_scale_master.py --stop
Restart=on-failure
RestartSec=30
TimeoutStopSec=1200
KillMode=mixed
StandardOutput=append:/home/insightlabs38/latticelm/artifacts/logs/final_scale_master.log
StandardError=append:/home/insightlabs38/latticelm/artifacts/logs/final_scale_master.log

[Install]
WantedBy=multi-user.target
