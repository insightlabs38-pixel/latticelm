[Unit]
Description=LatticeLM 15-day autonomous research master
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/insightlabs38/latticelm
ExecStart=/home/insightlabs38/latticelm/.venv/bin/python -u scripts/posthack_master.py
Restart=on-failure
RestartSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
