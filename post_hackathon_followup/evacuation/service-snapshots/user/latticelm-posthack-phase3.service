[Unit]
Description=LatticeLM post-hackathon Phase 3 data, growth, and PHM screens
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/insightlabs38/latticelm
ExecStart=/home/insightlabs38/latticelm/.venv/bin/python -u scripts/posthack_phase3.py
Restart=on-failure
RestartSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
